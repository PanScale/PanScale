{
  "name": "panscale-site",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare-site": "agentvibes-site prepare",
    "dev": "agentvibes-site prepare && next dev --port ${PORT:-7780}",
    "build": "agentvibes-site prepare && next build",
    "start": "next start --port ${PORT:-7780}",
    "check": "agentvibes-site prepare && tsc -p tsconfig.json --noEmit && next build",
    "doctor": "site-doctor check --next . --site ."
  },
  "dependencies": {
    "@byoklab/site": "^0.4.2",
    "@byoklab/site-config": "^0.3.0",
    "@panscale/core": "workspace:*",
    "@panscale/react": "workspace:*",
    "@panscale/web": "workspace:*",
    "fumadocs-core": "~16.4.9",
    "fumadocs-mdx": "~14.2.6",
    "fumadocs-ui": "~16.4.9",
    "motion": "^12.35.1",
    "next": "^16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@byoklab/site-doctor": "^0.3.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3"
  }
}
