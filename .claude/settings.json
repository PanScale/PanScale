{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "pnpm exec guardrails hook-postedit" }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "pnpm exec guardrails hook-stop" }]
      }
    ]
  }
}
